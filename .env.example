# Shared secret for the webhook endpoint. Use a long random value.
TOKEN=replace-with-random-token

# Address and port sms-relay listens on.
HOST=127.0.0.1
PORT=3000

# Webhook path for iPhone Shortcuts. Set to / to accept POST requests at the root path.
WEBHOOK_PATH=/sms

# Health check path.
HEALTH_PATH=/health

# Duplicate SMS suppression window in seconds. Set 0 to disable dedupe.
DEDUPE_TTL_SECONDS=120

# Maximum request body size in bytes.
MAX_BODY_BYTES=65536

# Log level: debug, info, error, silent, or off.
LOG_LEVEL=info

# Optional one-line message template. Leave empty to use the default Chinese format.
MESSAGE_TEMPLATE=

# Optional path to a mounted multiline template file. Takes precedence over MESSAGE_TEMPLATE.
# MESSAGE_TEMPLATE_FILE=/app/config/message-template.txt

# OpeniLink Hub base URL and send endpoint path.
OPENILINK_URL=http://127.0.0.1:9800
OPENILINK_SEND_PATH=/bot/v1/message/send

# OpeniLink App token and target WeChat user id.
OPENILINK_APP_TOKEN=replace-with-openilink-app-token
OPENILINK_TO=replace-with-wechat-user-id
